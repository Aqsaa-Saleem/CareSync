rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read-only reference data (doctors, centres, guides)
    // Adjust path names if you later move reference data into Firestore.
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }

    // A user's private profile, progress, notes, chat, and settings.
    // Users can only read/write their own document keyed by Firebase Auth UID.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
